rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /innetrening_exercises/{exerciseId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['name','focus','short','description','authorUid','createdAt'])
        && request.resource.data.keys().hasAll(['name','focus','short','description','authorUid','createdAt'])
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.focus is string && request.resource.data.focus.size() > 0 && request.resource.data.focus.size() <= 80
        && request.resource.data.short is string && request.resource.data.short.size() > 0 && request.resource.data.short.size() <= 180
        && request.resource.data.description is string && request.resource.data.description.size() > 0 && request.resource.data.description.size() <= 2500
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
